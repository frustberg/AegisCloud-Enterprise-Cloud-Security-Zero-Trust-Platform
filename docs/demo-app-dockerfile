# Save as Dockerfile in a new directory, build, and push to the ECR repo
# created by terraform/containerized-workload.
#
# Hardening choices worth being able to explain in an interview:
#   - Multi-stage build: final image contains no build tools, no source
#     package manager, minimal attack surface
#   - Non-root user (matches the task definition's `user: 1000:1000`)
#   - Read-only root filesystem compatible (matches
#     `readonlyRootFilesystem: true` in the task definition)
#   - Distroless-style minimal base rather than a full OS image

FROM python:3.12-slim AS builder
WORKDIR /app
COPY app.py /app/app.py

FROM python:3.12-slim
RUN groupadd -g 1000 appuser && useradd -u 1000 -g appuser -m appuser
WORKDIR /app
COPY --from=builder /app/app.py /app/app.py
USER 1000:1000
EXPOSE 8080
CMD ["python3", "app.py"]

